{
  "system": "library",
  "purpose": "pilot",
  "note": "Dane pilotażowe; nie stanowią eksperymentu głównego.",
  "vocabulary": {
    "states": [
      "Requested",
      "Reserved",
      "Borrowed",
      "Returned",
      "Cancelled",
      "Rated"
    ],
    "events": [
      "reserve",
      "borrow",
      "return",
      "cancel",
      "rate"
    ],
    "guards": [
      "member_active",
      "member_inactive",
      "copy_available",
      "copy_unavailable"
    ],
    "exclusive": [
      [
        "member_active",
        "member_inactive"
      ],
      [
        "copy_available",
        "copy_unavailable"
      ]
    ]
  },
  "initial": "Requested",
  "steps": [
    {
      "type": "initial",
      "add": [
        {
          "id": "R1",
          "text": "W procesie wypożyczenia bibliotecznego: z Requested zdarzenie reserve prowadzi do Reserved; dalsze reguły mogą ograniczać jego dostępność.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Requested",
              "event": "reserve",
              "to": "Reserved"
            }
          ]
        },
        {
          "id": "R2",
          "text": "Z Reserved zdarzenie borrow prowadzi do Borrowed wtedy i tylko wtedy, gdy zachodzi member_active.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Reserved",
              "event": "borrow",
              "guard": "member_active",
              "to": "Borrowed"
            },
            {
              "type": "no_transition",
              "from": "Reserved",
              "event": "borrow",
              "guard": "member_inactive"
            }
          ]
        },
        {
          "id": "R3",
          "text": "Z Borrowed zdarzenie return prowadzi do Returned; dalsze reguły mogą ograniczać jego dostępność.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Borrowed",
              "event": "return",
              "to": "Returned"
            }
          ]
        },
        {
          "id": "R4",
          "text": "W stanie Borrowed zdarzenie cancel jest zabronione.",
          "tests": [
            {
              "type": "no_transition",
              "from": "Borrowed",
              "event": "cancel"
            }
          ]
        },
        {
          "id": "R5",
          "text": "Stan Returned jest osiągalny; każda droga do niego musi przejść przez Borrowed.",
          "tests": [
            {
              "type": "reachable",
              "state": "Returned"
            },
            {
              "type": "always_before",
              "state": "Returned",
              "before": "Borrowed"
            }
          ]
        }
      ],
      "W": [
        [
          "Requested",
          "reserve",
          null,
          "Reserved"
        ],
        [
          "Reserved",
          "borrow",
          "member_active",
          "Borrowed"
        ],
        [
          "Borrowed",
          "return",
          null,
          "Returned"
        ]
      ],
      "P": []
    },
    {
      "type": "new_dependency",
      "description": "Uzależniamy reserve od copy_available.",
      "add": [
        {
          "id": "R7",
          "text": "Zdarzenie reserve w Requested jest dozwolone tylko przy copy_available, a wtedy prowadzi do Reserved.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Requested",
              "event": "reserve",
              "guard": "copy_available",
              "to": "Reserved"
            },
            {
              "type": "no_transition",
              "from": "Requested",
              "event": "reserve",
              "guard": "copy_unavailable"
            }
          ]
        }
      ],
      "affects": [
        "R1"
      ],
      "W": [
        [
          "Requested",
          "reserve",
          "copy_available",
          "Reserved"
        ],
        [
          "Reserved",
          "borrow",
          "member_active",
          "Borrowed"
        ],
        [
          "Borrowed",
          "return",
          null,
          "Returned"
        ]
      ],
      "P": []
    },
    {
      "type": "transition_change",
      "description": "Usuwamy ograniczenie member_active dla borrow.",
      "add": [
        {
          "id": "R2",
          "text": "Z Reserved zdarzenie borrow bez warunku prowadzi do Borrowed.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Reserved",
              "event": "borrow",
              "guard": null,
              "to": "Borrowed"
            }
          ]
        }
      ],
      "W": [
        [
          "Requested",
          "reserve",
          "copy_available",
          "Reserved"
        ],
        [
          "Reserved",
          "borrow",
          null,
          "Borrowed"
        ],
        [
          "Borrowed",
          "return",
          null,
          "Returned"
        ]
      ],
      "P": []
    },
    {
      "type": "new_rule",
      "description": "Dodajemy czynność po zakończeniu procesu.",
      "add": [
        {
          "id": "R6",
          "text": "Z Returned zdarzenie rate bez warunku prowadzi do Rated.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Returned",
              "event": "rate",
              "guard": null,
              "to": "Rated"
            }
          ]
        }
      ],
      "W": [
        [
          "Requested",
          "reserve",
          "copy_available",
          "Reserved"
        ],
        [
          "Reserved",
          "borrow",
          null,
          "Borrowed"
        ],
        [
          "Borrowed",
          "return",
          null,
          "Returned"
        ],
        [
          "Returned",
          "rate",
          null,
          "Rated"
        ]
      ],
      "P": []
    },
    {
      "type": "removal",
      "description": "Usuwamy czynność po zakończeniu procesu.",
      "remove": [
        "R6"
      ],
      "W": [
        [
          "Requested",
          "reserve",
          "copy_available",
          "Reserved"
        ],
        [
          "Reserved",
          "borrow",
          null,
          "Borrowed"
        ],
        [
          "Borrowed",
          "return",
          null,
          "Returned"
        ]
      ],
      "P": []
    },
    {
      "type": "contradiction",
      "description": "Żądamy cancel w Borrowed, zachowując dotychczasowy zakaz.",
      "add": [
        {
          "id": "R8",
          "text": "Z Borrowed zdarzenie cancel ma być dozwolone i prowadzić do Cancelled.",
          "tests": [
            {
              "type": "has_transition",
              "from": "Borrowed",
              "event": "cancel",
              "to": "Cancelled"
            }
          ]
        }
      ],
      "kind": "state",
      "conflicting": [
        "R4",
        "R8"
      ]
    }
  ]
}
