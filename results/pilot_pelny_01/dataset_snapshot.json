  "conflicts": {
    "access": [
      {
        "id": "Z1",
        "kind": "state",
        "description": "Dodajemy revoke w Active mimo zachowanego zakazu.",
        "add": [
          {
            "id": "R8",
            "text": "Z Active zdarzenie revoke ma być dozwolone i prowadzić do Revoked.",
